<!DOCTYPE html>
<html lang="fr" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Trendyshop - Votre boutique en ligne</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"
    />

    <style>
      .product-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 10px 25px rgba(0, 0, 0, 0.1);
      }
      .cart-badge {
        position: absolute;
        top: -8px;
        right: -8px;
        background-color: #ef4444;
        color: white;
        border-radius: 50%;
        width: 20px;
        height: 20px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 12px;
      }
    </style>

    <% if (successMessage && successMessage.length > 0) { %>
    <div class="bg-green-500 text-white text-center py-3 mb-4 rounded">
      <%= successMessage %>
    </div>
    <% } %> <% if (errorMessages && errorMessages.length > 0) { %>
    <div class="bg-red-500 text-white text-center py-3 mb-4 rounded">
      <%= errorMessages %>
    </div>
    <% } %>
  </head>

  <body class="bg-gray-50 font-sans">
    <!-- Navigation -->
    <nav class="bg-white shadow-md sticky top-0 z-50">
      <div
        class="container mx-auto px-4 py-3 flex justify-between items-center"
      >
        <!-- LOGO -->
        <a href="/" class="text-2xl font-bold text-indigo-600"> TrendyShop </a>

        <!-- MENU DESKTOP -->
        <div class="hidden md:flex space-x-8">
          <a href="/" class="text-gray-700 hover:text-indigo-600">
            <%= __("menu.home") %>
          </a>
          <a href="#products" class="text-gray-700 hover:text-indigo-600">
            <%= __("menu.products") %>
          </a>
          <a href="#about" class="text-gray-700 hover:text-indigo-600">
            <%= __("menu.about") %>
          </a>
          <a href="#contact" class="text-gray-700 hover:text-indigo-600">
            <%= __("menu.contact") %>
          </a>
        </div>

        <!-- ACTIONS + HAMBURGER -->
        <div class="flex items-center space-x-4">
          <!-- Panier -->
          <a
            href="/cart"
            class="relative text-gray-700 hover:text-indigo-600 transition"
          >
            <i class="fas fa-shopping-cart text-xl"></i>
            <span class="cart-badge"><%= cartCount || 0 %></span>
          </a>

          <% if (session.user?.isAdmin) { %>
          <a href="/admin" class="text-red-600 font-bold hidden md:inline"
            >Admin</a
          >
          <% } %>

          <!-- Compte (desktop) -->
          <div class="hidden md:flex items-center gap-3">
            <% if (!session.user) { %>
            <a href="/connexion" class="text-gray-700 hover:text-indigo-600">
              <i class="fas fa-user text-xl"></i>
            </a>
            <% } else { %>
            <span class="text-sm font-semibold">
              Bonjour <%= session.user.name %>
            </span>
            <a href="/dashboard" class="text-indigo-600 text-sm">Dashboard</a>
            <a
              href="/connexion/logout"
              class="text-red-600 text-sm hover:underline"
            >
              Déconnexion
            </a>
            <% } %>
          </div>

          <!-- LANGUE (desktop) -->
          <div class="relative hidden md:block">
            <button
              id="langBtn"
              class="text-gray-700 hover:text-indigo-600 flex items-center gap-1"
            >
              <i class="fas fa-globe text-xl"></i>
              <span class="text-sm uppercase"><%= currentLang %></span>
            </button>

            <div
              id="langMenu"
              class="absolute right-0 mt-2 w-36 bg-white shadow-lg rounded hidden z-50"
            >
              <a href="/lang/fr" class="block px-4 py-2 hover:bg-gray-100"
                >🇫🇷 Français</a
              >
              <a href="/lang/en" class="block px-4 py-2 hover:bg-gray-100"
                >🇬🇧 English</a
              >
              <a href="/lang/de" class="block px-4 py-2 hover:bg-gray-100"
                >🇩🇪 Deutsch</a
              >
              <a href="/lang/it" class="block px-4 py-2 hover:bg-gray-100"
                >🇮🇹 Italiano</a
              >
            </div>
          </div>

          <!-- BOUTON HAMBURGER (mobile) -->
          <button
            id="mobileMenuBtn"
            class="md:hidden text-gray-700 hover:text-indigo-600"
            aria-label="Open menu"
          >
            <i class="fas fa-bars text-2xl"></i>
          </button>
        </div>
      </div>

      <!-- MENU MOBILE -->
      <div id="mobileMenu" class="md:hidden hidden border-t bg-white">
        <div class="px-4 py-4 space-y-3">
          <a href="/" class="block text-gray-700 hover:text-indigo-600">
            <%= __("menu.home") %>
          </a>
          <a href="#products" class="block text-gray-700 hover:text-indigo-600">
            <%= __("menu.products") %>
          </a>
          <a href="#about" class="block text-gray-700 hover:text-indigo-600">
            <%= __("menu.about") %>
          </a>
          <a href="#contact" class="block text-gray-700 hover:text-indigo-600">
            <%= __("menu.contact") %>
          </a>

          <hr class="my-2" />

          <!-- Compte (mobile) -->
          <% if (!session.user) { %>
          <a
            href="/connexion"
            class="block text-gray-700 hover:text-indigo-600"
          >
            <i class="fas fa-user mr-2"></i> Connexion
          </a>
          <% } else { %>
          <div class="text-sm font-semibold text-gray-700">
            Bonjour <%= session.user.name %>
          </div>
          <a href="/dashboard" class="block text-indigo-600">Dashboard</a>
          <a href="/connexion/logout" class="block text-red-600">Déconnexion</a>
          <% } %> <% if (session.user?.isAdmin) { %>
          <a href="/admin" class="block text-red-600 font-bold">Admin</a>
          <% } %>

          <hr class="my-2" />

          <!-- Langue (mobile) -->
          <div class="space-y-2">
            <div class="text-xs uppercase text-gray-500">Langue</div>
            <div class="flex flex-wrap gap-2">
              <a
                href="/lang/fr"
                class="px-3 py-1 rounded bg-gray-100 hover:bg-gray-200"
                >🇫🇷 FR</a
              >
              <a
                href="/lang/en"
                class="px-3 py-1 rounded bg-gray-100 hover:bg-gray-200"
                >🇬🇧 EN</a
              >
              <a
                href="/lang/de"
                class="px-3 py-1 rounded bg-gray-100 hover:bg-gray-200"
                >🇩🇪 DE</a
              >
              <a
                href="/lang/it"
                class="px-3 py-1 rounded bg-gray-100 hover:bg-gray-200"
                >🇮🇹 IT</a
              >
            </div>
          </div>
        </div>
      </div>
    </nav>

    <script>
      // Desktop language dropdown (ton code existant, légèrement sécurisé)
      const langBtn = document.getElementById("langBtn");
      const langMenu = document.getElementById("langMenu");
      if (langBtn && langMenu) {
        langBtn.addEventListener("click", (e) => {
          e.stopPropagation();
          langMenu.classList.toggle("hidden");
        });
        document.addEventListener("click", () => {
          langMenu.classList.add("hidden");
        });
      }

      // Mobile hamburger
      const mobileBtn = document.getElementById("mobileMenuBtn");
      const mobileMenu = document.getElementById("mobileMenu");

      if (mobileBtn && mobileMenu) {
        mobileBtn.addEventListener("click", () => {
          mobileMenu.classList.toggle("hidden");
        });

        // fermer le menu quand on clique sur un lien
        mobileMenu.querySelectorAll("a").forEach((a) => {
          a.addEventListener("click", () => {
            mobileMenu.classList.add("hidden");
          });
        });
      }
    </script>

    <!-- Hero -->
    <section
      id="home"
      class="bg-gradient-to-r from-indigo-500 to-purple-600 text-white py-20"
    >
      <div
        class="container mx-auto px-4 flex flex-col md:flex-row items-center"
      >
        <div class="md:w-1/2">
          <h1 class="text-5xl font-bold mb-4">
            Découvrez notre collection exclusive
          </h1>
          <p class="text-xl mb-8">
            Des produits de qualité à des prix imbattables.
          </p>
          <a
            href="#products"
            class="bg-white text-indigo-600 px-6 py-3 rounded-lg font-semibold hover:bg-gray-100"
          >
            Voir les produits
          </a>
        </div>

        <div class="md:w-1/2 flex justify-center">
          <img
            src="/img/miroir 360 2.jpg"
            class="rounded-lg shadow-2xl"
            alt=""
          />
        </div>
      </div>
    </section>

    <!-- PRODUITS DYNAMIQUES -->
    <section id="products" class="py-16 bg-white">
      <div class="container mx-auto px-4">
        <h2 class="text-3xl font-bold text-center mb-12">
          Nos Produits Populaires
        </h2>

        <div
          class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-8"
        >
          <% products.forEach(product => { %>
          <div
            class="product-card bg-white rounded-lg shadow-md overflow-hidden"
          >
            <div class="relative">
              <img
                src="<%= product.imageUrl %>"
                class="w-full h-48 object-cover"
                alt=""
              />
              <div
                class="absolute top-2 right-2 bg-indigo-600 text-white px-2 py-1 rounded-full text-xs font-semibold"
              >
                Promo
              </div>
            </div>

            <div class="p-4">
              <h3 class="font-semibold text-lg mb-1"><%= product.name %></h3>

              <div class="flex items-center mb-2">
                <div class="flex text-yellow-400">
                  <i class="fas fa-star"></i>
                  <i class="fas fa-star"></i>
                  <i class="fas fa-star"></i>
                  <i class="fas fa-star"></i>
                  <i class="fas fa-star-half-alt"></i>
                </div>
                <span class="ml-2 text-gray-500 text-sm">(120)</span>
              </div>

              <div class="flex justify-between items-center">
                <div>
                  <% if (product.oldPrice) { %>
                  <span class="line-through text-gray-500 text-sm"
                    >€<%= product.oldPrice %></span
                  >
                  <% } %>
                  <span class="text-indigo-600 font-bold ml-2"
                    >€<%= product.price %></span
                  >
                </div>

                <div class="flex space-x-2">
                  <!-- Ajouter au panier -->
                  <form action="/cart/add" method="POST">
                    <input
                      type="hidden"
                      name="productId"
                      value="<%= product.id %>"
                    />
                    <button class="bg-indigo-600 text-white p-2 rounded-full">
                      <i class="fas fa-shopping-cart"></i>
                    </button>
                  </form>

                  <!-- Achat direct -->
                  <form action="/checkout/checkout-single" method="post">
                    <input
                      type="hidden"
                      name="productId"
                      value="<%= product.id %>"
                    />
                    <input type="hidden" name="quantity" value="1" />
                    <button class="bg-green-500 text-white px-3 py-1 rounded">
                      Acheter
                    </button>
                  </form>
                </div>
              </div>
            </div>
          </div>
          <% }) %>
        </div>
      </div>
    </section>

    <!-- À propos -->
    <section id="about" class="py-16 bg-gray-100">
      <div class="container mx-auto px-4">
        <div class="flex flex-col md:flex-row items-center">
          <div class="md:w-1/2">
            <h2 class="text-3xl font-bold mb-6">À propos de TrendyShop</h2>
            <p class="text-gray-700 mb-4">
              Fondée en 2010, TrendyShop est devenue l'une des principales
              plateformes de commerce électronique, offrant une large gamme de
              produits de haute qualité à des prix compétitifs. Notre mission
              est de fournir une expérience d'achat en ligne exceptionnelle avec
              un service clientèle de premier ordre et une livraison rapide dans
              le monde entier. Plus de 10 000 produits disponibles Livraison
              dans plus de 100 pays Support client 24/7
            </p>
          </div>
          <div class="md:w-1/2">
            <img
              src="/img/trendy shop.png"
              class="rounded-lg shadow-lg"
              alt=""
            />
          </div>
        </div>
      </div>
    </section>

    <!-- Footer -->
    <footer
      id="contact"
      class="bg-gradient-to-r from-indigo-500 to-purple-600 text-white py-10"
    >
      <div class="container mx-auto px-4 max-w-xl">
        <h2 class="text-xl font-semibold mb-4">Contactez-nous</h2>

        <form action="/contact" method="POST" class="space-y-4">
          <input
            type="text"
            name="name"
            placeholder="Votre nom"
            class="w-full p-2 rounded text-black"
            required
          />

          <input
            type="email"
            name="email"
            placeholder="Votre email"
            class="w-full p-2 rounded text-black"
            required
          />

          <textarea
            name="message"
            placeholder="Votre message"
            class="w-full p-2 rounded text-black"
            rows="4"
            required
          ></textarea>

          <button
            type="submit"
            class="bg-white text-indigo-600 px-4 py-2 rounded hover:bg-gray-100"
          >
            Envoyer
          </button>
        </form>
      </div>
    </footer>
  </body>
</html>
